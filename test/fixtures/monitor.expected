# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
5 * * * * echo "$(date -Is) ZFS-JOB BEGIN testhost hourly snapshot (groupA)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_hourly_" -e -v 3 "tank/a,tank/b" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost hourly snapshot (groupA) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost hourly snapshot (groupA)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
10 0 * * * echo "$(date -Is) ZFS-JOB BEGIN testhost daily snapshot (groupA)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_daily_" -e -v 3 "tank/a,tank/b" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost daily snapshot (groupA) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost daily snapshot (groupA)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

35 * * * * echo "$(date -Is) ZFS-JOB BEGIN testhost hourly prune (groupA)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh "tank/a,tank/b" "automated_hourly" -H24 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost hourly prune (groupA) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost hourly prune (groupA)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
40 0 * * * echo "$(date -Is) ZFS-JOB BEGIN testhost daily prune (groupA)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh "tank/a,tank/b" "automated_daily" -D7 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost daily prune (groupA) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost daily prune (groupA)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
50 0 * * 0 echo "$(date -Is) ZFS-JOB BEGIN testhost weekly prune (store)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -R "backup/store" "automated_weekly" -W8 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost weekly prune (store) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost weekly prune (store)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

*/15 * * * * d=$(/REPO/check-snap-age.sh "tank/a,tank/b" "automated_hourly" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "testhost hourly getting stale (groupA)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "testhost hourly stale (groupA)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "testhost hourly monitor BROKEN (groupA)" "$d" 2>>/LOG
0 */6 * * * d=$(/REPO/check-snap-age.sh -R "backup/store" "automated_weekly" 9d 12d 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "testhost weekly getting stale (store)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "testhost weekly stale (store)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "testhost weekly monitor BROKEN (store)" "$d" 2>>/LOG
# END zfs-backup-managed
