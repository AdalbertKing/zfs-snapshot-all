# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
59 * * * * e=$(mktemp); /REPO/snapsend.sh -m "automated_" -e -u "tank/replica" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly backup (repl)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

51 * * * * e=$(mktemp); /REPO/delsnaps.sh -R -F "backup/arc" "automated_hourly" -H48 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly prune (arc)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
