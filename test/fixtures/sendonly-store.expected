# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (repl)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_" -e -u "tank/replica" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (repl) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly backup (repl)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

51 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly prune (arc)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -R -F "backup/arc" "automated_hourly" -H48 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc hourly prune (arc) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly prune (arc)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
