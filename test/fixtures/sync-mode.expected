# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (push base)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_" -A "tank/push-base" "user@far:backup/base" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (push base) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "pve1 hourly backup (push base)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (push sync)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_" -A "tank/push-sync" "user@far" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (push sync) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "pve1 hourly backup (push sync)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (push local)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_" "tank/push-local" "backup/local" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (push local) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "pve1 hourly backup (push local)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (pull sync)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapget.sh -m "automated_" -A "user@far:tank/pull-sync" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (pull sync) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "pve1 hourly backup (pull sync)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
