# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (push base)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -A "tank/push-base" "user@far:backup/base" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (push base) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1 hourly backup (push base)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (push sync)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -A "tank/push-sync" "user@far" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (push sync) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1 hourly backup (push sync)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (push local)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" "tank/push-local" "backup/local" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (push local) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1 hourly backup (push local)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (pull sync)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapget.sh -m "automated_" -A "user@far:tank/pull-sync" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (pull sync) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1 hourly backup (pull sync)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
