# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
51 * * * * echo "$(date -Is) ZFS-JOB BEGIN testhost gfs prune (store)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -G -R "backup/store" "automated_" -H24 -D7 -W4 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost gfs prune (store) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost gfs prune (store)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

*/15 * * * * d=$(/REPO/check-snap-age.sh -R "backup/store" "automated_hourly" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "testhost store_hourly getting stale (store)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "testhost store_hourly stale (store)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "testhost store_hourly monitor BROKEN (store)" "$d" 2>>/LOG

0 7 * * * /DIGEST 2>>/LOG
# END zfs-backup-managed
