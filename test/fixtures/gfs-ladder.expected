# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
51 * * * * echo "$(date -Is) ZFS-JOB BEGIN testhost gfs prune (store)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -G -R "backup/store" "automated_" -H24 -D7 -W4 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END testhost gfs prune (store) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "testhost gfs prune (store)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"

*/15 * * * * d=$($ZSA_REPO/check-snap-age.sh -R "backup/store" "automated_hourly" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>$ZSA_LOG; [ $rc -eq 1 ] && $ZSA_WARN "testhost store_hourly getting stale (store)" "$d" 2>>$ZSA_LOG; [ $rc -eq 2 ] && $ZSA_NOTIFY "testhost store_hourly stale (store)" "$d" 2>>$ZSA_LOG; [ $rc -ge 3 ] && $ZSA_NOTIFY "testhost store_hourly monitor BROKEN (store)" "$d" 2>>$ZSA_LOG
# END zfs-backup-managed
