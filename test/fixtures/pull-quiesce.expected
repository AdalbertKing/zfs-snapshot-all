# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
0 0 * * * echo "$(date -Is) ZFS-JOB BEGIN collector pq_daily backup (pve2-data)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapget.sh -m "automated_daily_" -A -q agent "zfsbackup-collector@192.0.2.55:rpool/data" "hdd/backups/pve2" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END collector pq_daily backup (pve2-data) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "collector pq_daily backup (pve2-data)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

10 0 * * * echo "$(date -Is) ZFS-JOB BEGIN collector pq_daily prune (pve2-data)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh "hdd/backups/pve2/rpool/data" "automated_daily" -D7 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END collector pq_daily prune (pve2-data) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "collector pq_daily prune (pve2-data)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
