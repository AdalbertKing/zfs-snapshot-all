# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
0 0 * * * echo "$(date -Is) ZFS-JOB BEGIN collector pq_daily backup (pve2-data)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapget.sh -m "automated_daily_" -A -q agent "zfsbackup-collector@192.0.2.55:rpool/data" "hdd/backups/pve2" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END collector pq_daily backup (pve2-data) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "collector pq_daily backup (pve2-data)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"

10 0 * * * echo "$(date -Is) ZFS-JOB BEGIN collector pq_daily prune (pve2-data)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh "hdd/backups/pve2/rpool/data" "automated_daily" -D7 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END collector pq_daily prune (pve2-data) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "collector pq_daily prune (pve2-data)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
