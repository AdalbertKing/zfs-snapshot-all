# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
*/15 * * * * d=$($ZSA_REPO/check-snap-age.sh "tank/watched1,tank/watched2" "automated_hourly_" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>$ZSA_LOG; [ $rc -eq 1 ] && $ZSA_WARN "watchonly hourly getting stale (watched1)" "$d" 2>>$ZSA_LOG; [ $rc -eq 2 ] && $ZSA_NOTIFY "watchonly hourly stale (watched1)" "$d" 2>>$ZSA_LOG; [ $rc -ge 3 ] && $ZSA_NOTIFY "watchonly hourly monitor BROKEN (watched1)" "$d" 2>>$ZSA_LOG
# END zfs-backup-managed
