# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
0 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc create-prefixed backup (cp)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" "tank/create-prefixed" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc create-prefixed backup (cp) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc create-prefixed backup (cp)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
0 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc create-noprefix backup (cn)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "" "tank/create-noprefix" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc create-noprefix backup (cn) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc create-noprefix backup (cn)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
15 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc existing-prefixed backup (ep)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e "tank/existing-prefixed" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc existing-prefixed backup (ep) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc existing-prefixed backup (ep)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
15 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc existing-noprefix backup (en)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "" -e "tank/existing-noprefix" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc existing-noprefix backup (en) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc existing-noprefix backup (en)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
