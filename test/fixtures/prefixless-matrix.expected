0 * * * * e=$(mktemp); /REPO/snapsend.sh -m "" "tank/create-noprefix" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc create-noprefix backup (cn)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
15 * * * * e=$(mktemp); /REPO/snapsend.sh -m "automated_" -e "tank/existing-prefixed" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc existing-prefixed backup (ep)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
15 * * * * e=$(mktemp); /REPO/snapsend.sh -m "" -e "tank/existing-noprefix" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc existing-noprefix backup (en)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
