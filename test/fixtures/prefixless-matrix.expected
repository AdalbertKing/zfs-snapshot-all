# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
0 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc create-prefixed backup (cp)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_" "tank/create-prefixed" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc create-prefixed backup (cp) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc create-prefixed backup (cp)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
0 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc create-noprefix backup (cn)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "" "tank/create-noprefix" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc create-noprefix backup (cn) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc create-noprefix backup (cn)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
15 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc existing-prefixed backup (ep)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_" -e "tank/existing-prefixed" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc existing-prefixed backup (ep) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc existing-prefixed backup (ep)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
15 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc existing-noprefix backup (en)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "" -e "tank/existing-noprefix" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc existing-noprefix backup (en) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc existing-noprefix backup (en)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
