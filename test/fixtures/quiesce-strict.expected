# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (vm301)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -q auto,strict "tank/vm-301-disk-0" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (vm301) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (vm301)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
