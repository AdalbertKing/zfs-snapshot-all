59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (plainnone)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" "tank/plain-none" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (plainnone) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (plainnone)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
