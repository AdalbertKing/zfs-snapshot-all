*/15 * * * * d=$($ZSA_REPO/check-snap-age.sh "tank/single,tank/explicitno" "automated_" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>$ZSA_LOG; [ $rc -eq 1 ] && $ZSA_WARN "arc hourly getting stale (single)" "$d" 2>>$ZSA_LOG; [ $rc -eq 2 ] && $ZSA_NOTIFY "arc hourly stale (single)" "$d" 2>>$ZSA_LOG; [ $rc -ge 3 ] && $ZSA_NOTIFY "arc hourly monitor BROKEN (single)" "$d" 2>>$ZSA_LOG
*/15 * * * * d=$($ZSA_REPO/check-snap-age.sh -R "tank/flatpush,tank/atompush,hdd/backups/arc/flatpull/tank/data,hdd/backups/arc/atompull/tank/data2" "automated_" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>$ZSA_LOG; [ $rc -eq 1 ] && $ZSA_WARN "arc hourly getting stale (flatpush)" "$d" 2>>$ZSA_LOG; [ $rc -eq 2 ] && $ZSA_NOTIFY "arc hourly stale (flatpush)" "$d" 2>>$ZSA_LOG; [ $rc -ge 3 ] && $ZSA_NOTIFY "arc hourly monitor BROKEN (flatpush)" "$d" 2>>$ZSA_LOG
