7 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (atompull)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapget.sh -m "automated_" -r -A "zfsbackup-arc@10.0.0.2:tank/data2" "hdd/backups/arc/atompull" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (atompull) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (atompull)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"

30 2 * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly prune (single)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh "tank/single" "automated_" -H24 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly prune (single) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly prune (single)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
