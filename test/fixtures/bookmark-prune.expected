# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
30 4 * * * echo "$(date -Is) ZFS-JOB BEGIN arc bookmarks prune (orphans)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -B "tank/src1,tank/src2" "tgt-" -d30 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc bookmarks prune (orphans) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc bookmarks prune (orphans)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
30 4 * * * echo "$(date -Is) ZFS-JOB BEGIN arc bookmarks prune (orphans)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -B -R "tank/deep" "tgt-" -d30 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc bookmarks prune (orphans) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc bookmarks prune (orphans)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
0 5 * * * echo "$(date -Is) ZFS-JOB BEGIN arc bookmarks prune (custom)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -B "tank/custom" "mytag-" -h12 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc bookmarks prune (custom) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc bookmarks prune (custom)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
