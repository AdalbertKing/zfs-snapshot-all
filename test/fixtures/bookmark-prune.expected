# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
30 4 * * * echo "$(date -Is) ZFS-JOB BEGIN arc bookmarks prune (orphans)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -B "tank/src1,tank/src2" "tgt-" -d30 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc bookmarks prune (orphans) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc bookmarks prune (orphans)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
30 4 * * * echo "$(date -Is) ZFS-JOB BEGIN arc bookmarks prune (orphans)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -B -R "tank/deep" "tgt-" -d30 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc bookmarks prune (orphans) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc bookmarks prune (orphans)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
0 5 * * * echo "$(date -Is) ZFS-JOB BEGIN arc bookmarks prune (custom)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -B "tank/custom" "mytag-" -h12 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc bookmarks prune (custom) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc bookmarks prune (custom)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
