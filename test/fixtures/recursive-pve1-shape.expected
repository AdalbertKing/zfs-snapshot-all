# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
1 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1.11 hourly snapshot (rpool-data)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_hourly_" -r -v 3 "rpool/data" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1.11 hourly snapshot (rpool-data) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1.11 hourly snapshot (rpool-data)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
12 0 * * * echo "$(date -Is) ZFS-JOB BEGIN pve1.11 daily snapshot (rpool-data)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_daily_" -r -v 3 -q agent "rpool/data" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1.11 daily snapshot (rpool-data) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1.11 daily snapshot (rpool-data)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 23 30 04 * echo "$(date -Is) ZFS-JOB BEGIN pve1.11 annual snapshot (rpool-data)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_annual_" -r -v 3 -q agent "rpool/data" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1.11 annual snapshot (rpool-data) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1.11 annual snapshot (rpool-data)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"

58 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1.11 flat prune (rpool-data)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -R "rpool/data" "automated_" -h 12 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1.11 flat prune (rpool-data) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1.11 flat prune (rpool-data)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"

*/15 * * * * d=$($ZSA_REPO/check-snap-age.sh -R "rpool/data" "automated_" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>$ZSA_LOG; [ $rc -eq 1 ] && $ZSA_WARN "pve1.11 flat getting stale (rpool-data)" "$d" 2>>$ZSA_LOG; [ $rc -eq 2 ] && $ZSA_NOTIFY "pve1.11 flat stale (rpool-data)" "$d" 2>>$ZSA_LOG; [ $rc -ge 3 ] && $ZSA_NOTIFY "pve1.11 flat monitor BROKEN (rpool-data)" "$d" 2>>$ZSA_LOG
# END zfs-backup-managed
