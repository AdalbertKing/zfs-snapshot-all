59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (pull sync)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapget.sh -m "automated_" -e -v 3 -A "root@source:tank/syncsrc" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (pull sync) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "pve1 hourly backup (pull sync)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
