# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (push)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -v 3 -A "tank/push" "root@far:backup/pve1" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (push) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1 hourly backup (push)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (pull)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapget.sh -m "automated_" -e -v 3 -A "root@source:pull" "tank" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (pull) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1 hourly backup (pull)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (pull no autotune)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapget.sh -m "automated_" -e -v 3 "root@source:pull-noauto" "tank" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (pull no autotune) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1 hourly backup (pull no autotune)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN pve1 hourly backup (pull sync)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapget.sh -m "automated_" -e -v 3 -A "root@source:tank/syncsrc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END pve1 hourly backup (pull sync) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "pve1 hourly backup (pull sync)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
