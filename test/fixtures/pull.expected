# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
59 * * * * e=$(mktemp); /REPO/snapsend.sh -m "automated_" -e -v 3 -A "tank/push" "root@far:backup/pve1" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "pve1 hourly backup (push)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
59 * * * * e=$(mktemp); /REPO/snapget.sh -m "automated_" -e -v 3 -A "tank/pull" "root@source:tank/remote" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "pve1 hourly backup (pull)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
59 * * * * e=$(mktemp); /REPO/snapget.sh -m "automated_" -e -v 3 "tank/pull-local" "tank/localsrc" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "pve1 hourly backup (pull local)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
