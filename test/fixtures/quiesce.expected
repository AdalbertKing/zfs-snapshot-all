gen-cron.sh: warning: [dataset:tank/existing] tier=hourly: -q has no effect together with -e -- -e reuses an existing snapshot, so there is nothing being created for a freeze to make consistent
# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (vm101)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -q agent "tank/vm-101-disk-0" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (vm101) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (vm101)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (ct102)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -q sync "tank/subvol-102-disk-0" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (ct102) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (ct102)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (mixed)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -v 3 -q auto "tank/mixed" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (mixed) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (mixed)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (plain+off)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" "tank/plain,tank/off" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (plain+off) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (plain+off)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (existing)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -q agent "tank/existing" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (existing) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (existing)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
