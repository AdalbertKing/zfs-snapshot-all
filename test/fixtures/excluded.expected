# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
51 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly prune" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -P "__replicate_:1" -P "vzdump:all" "tank/vm1" "automated_hourly_" -H24 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly prune rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly prune" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
51 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly prune (store)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -P "__replicate_:1" -P "vzdump:all" "tank/store" "automated_hourly_" -H24 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly prune (store) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly prune (store)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
30 4 * * * echo "$(date -Is) ZFS-JOB BEGIN arc bookmarks prune (orphans)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -B "tank/vm1" "tgt-" -d30 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc bookmarks prune (orphans) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc bookmarks prune (orphans)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
