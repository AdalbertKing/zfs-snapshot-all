51 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly prune" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -P "__replicate_:1" -P "vzdump:all" "tank/vm1" "automated_hourly_" -H24 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc hourly prune rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly prune" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
51 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly prune (store)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -P "__replicate_:1" -P "vzdump:all" "tank/store" "automated_hourly_" -H24 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc hourly prune (store) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly prune (store)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
30 4 * * * echo "$(date -Is) ZFS-JOB BEGIN arc bookmarks prune (orphans)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -B "tank/vm1" "tgt-" -d30 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc bookmarks prune (orphans) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc bookmarks prune (orphans)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
