# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
5 * * * * echo "$(date -Is) ZFS-JOB BEGIN testhost hourly snapshot (groupA)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_hourly_" -e -v 3 "tank/a,tank/b" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost hourly snapshot (groupA) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost hourly snapshot (groupA)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
10 0 * * * echo "$(date -Is) ZFS-JOB BEGIN testhost daily snapshot (groupA+groupC)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_daily_" -e -v 3 "tank/a,tank/b,tank/c" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost daily snapshot (groupA+groupC) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost daily snapshot (groupA+groupC)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

35 * * * * echo "$(date -Is) ZFS-JOB BEGIN testhost hourly prune (groupA)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh "tank/a,tank/b" "automated_hourly" -H24 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost hourly prune (groupA) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost hourly prune (groupA)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
40 0 * * * echo "$(date -Is) ZFS-JOB BEGIN testhost daily prune (groupA)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh "tank/a,tank/b" "automated_daily" -D7 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost daily prune (groupA) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost daily prune (groupA)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
40 0 * * * echo "$(date -Is) ZFS-JOB BEGIN testhost daily prune (groupC)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh "tank/c" "automated_daily" -D14 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost daily prune (groupC) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost daily prune (groupC)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
50 0 * * * echo "$(date -Is) ZFS-JOB BEGIN testhost daily prune (store)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -R "backup/store" "automated_daily" -D30 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost daily prune (store) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost daily prune (store)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
