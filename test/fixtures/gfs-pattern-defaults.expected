# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
21 * * * * echo "$(date -Is) ZFS-JOB BEGIN testhost gfs prune (one)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -G "backup/one" "automated_" -H24 -D7 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END testhost gfs prune (one) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "testhost gfs prune (one)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
21 * * * * echo "$(date -Is) ZFS-JOB BEGIN testhost gfs prune (two)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -G -R "backup/two" "automated_" -H24 -D7 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END testhost gfs prune (two) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "testhost gfs prune (two)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
