# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
21 * * * * echo "$(date -Is) ZFS-JOB BEGIN testhost gfs prune (one)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -G "backup/one" "automated_" -H24 -D7 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost gfs prune (one) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost gfs prune (one)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
21 * * * * echo "$(date -Is) ZFS-JOB BEGIN testhost gfs prune (two)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -G -R "backup/two" "automated_" -H24 -D7 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END testhost gfs prune (two) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "testhost gfs prune (two)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
