# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
51 * * * * echo "$(date -Is) ZFS-JOB BEGIN t hourly prune (store)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -R "tank/store" "automated_hourly" -H24 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END t hourly prune (store) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "t hourly prune (store)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"

*/15 * * * * d=$($ZSA_REPO/check-snap-age.sh "tank/store/leaf" "automated_hourly" 200m 260m 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>$ZSA_LOG; [ $rc -eq 1 ] && $ZSA_WARN "t hourly getting stale (leaf)" "$d" 2>>$ZSA_LOG; [ $rc -eq 2 ] && $ZSA_NOTIFY "t hourly stale (leaf)" "$d" 2>>$ZSA_LOG; [ $rc -ge 3 ] && $ZSA_NOTIFY "t hourly monitor BROKEN (leaf)" "$d" 2>>$ZSA_LOG
# END zfs-backup-managed
