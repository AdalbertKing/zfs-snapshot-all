# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
51 * * * * e=$(mktemp); /REPO/delsnaps.sh -R "tank/store" "automated_hourly" -H24 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "t hourly prune (store)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

*/15 * * * * d=$(/REPO/check-snap-age.sh "tank/store/leaf" "automated_hourly" 200m 260m 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "t hourly getting stale (leaf)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "t hourly stale (leaf)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "t hourly monitor BROKEN (leaf)" "$d" 2>>/LOG

0 7 * * * /DIGEST 2>>/LOG
# END zfs-backup-managed
