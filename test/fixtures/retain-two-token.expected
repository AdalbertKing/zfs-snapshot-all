# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
37 * * * * echo "$(date -Is) ZFS-JOB BEGIN t hourly backup (x)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_hourly_" "tank/vm1" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END t hourly backup (x) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "t hourly backup (x)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"

51 * * * * echo "$(date -Is) ZFS-JOB BEGIN t hourly prune (x)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh "tank/vm1" "automated_hourly_" -h 12 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END t hourly prune (x) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "t hourly prune (x)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"

*/15 * * * * d=$($ZSA_REPO/check-snap-age.sh "tank/vm1" "automated_hourly_" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>$ZSA_LOG; [ $rc -eq 1 ] && $ZSA_WARN "t hourly getting stale (x)" "$d" 2>>$ZSA_LOG; [ $rc -eq 2 ] && $ZSA_NOTIFY "t hourly stale (x)" "$d" 2>>$ZSA_LOG; [ $rc -ge 3 ] && $ZSA_NOTIFY "t hourly monitor BROKEN (x)" "$d" 2>>$ZSA_LOG
# END zfs-backup-managed
