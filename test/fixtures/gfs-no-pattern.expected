# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
51 * * * * echo "$(date -Is) ZFS-JOB BEGIN t gfs prune (x)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/delsnaps.sh -G "tank/store" "" -H24 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END t gfs prune (x) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "t gfs prune (x)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
