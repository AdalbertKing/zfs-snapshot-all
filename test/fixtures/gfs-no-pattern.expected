# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
51 * * * * echo "$(date -Is) ZFS-JOB BEGIN t gfs prune (x)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -G "tank/store" "" -H24 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END t gfs prune (x) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "t gfs prune (x)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
