# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (local z)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -z "tank/local-z" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (local z) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (local z)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (local Z)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -Z "tank/local-Z" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (local Z) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (local Z)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (local g)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -g "tank/local-g" "backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (local g) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (local g)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (remote z)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -z "tank/remote-z" "root@far:backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (remote z) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (remote z)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (no dst)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -z "tank/nodst" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (no dst) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (no dst)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
