# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/WARN
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (remote)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -v 3 -A "tank/remote" "root@far:backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (remote) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (remote)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (local)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -v 3 "tank/local" "backup/local" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (local) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (local)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (already)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -A -v 3 "tank/already" "root@far:backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (already) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (already)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (explicit z)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -z -v 3 "tank/explicit-z" "root@far:backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (explicit z) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (explicit z)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (opted out)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -v 3 "tank/optedout" "root@far:backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (opted out) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (opted out)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (bare)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -A "tank/bare" "root@far:backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (bare) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (bare)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (tiered)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; $ZSA_REPO/snapsend.sh -m "automated_" -e -u -A "tank/tiered" "root@far:backup/arc" 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (tiered) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "arc hourly backup (tiered)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
