# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
59 * * * * echo "$(date -Is) ZFS-JOB BEGIN arc hourly backup (remote)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_" -e -v 3 -A "tank/remote" "root@far:backup/arc" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END arc hourly backup (remote) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly backup (remote)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
