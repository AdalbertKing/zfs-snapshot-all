# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
# Source: /jobs.h7.conf -- DO NOT EDIT BY HAND, re-run gen-cron.sh instead
30 2 * * * /REPO/zfs-job.sh "h7 replica copy (weekA)" --log=/LOG --notify=/NOTIFY --detail=8 -- /bin/sh -c '( /REPO/zfs-media-gate.sh attach usbrep1 weekA --dataset usbrep1/replica --source hdd/kopie --prefix replica_; a=$?; if [ $a -eq 0 ]; then /REPO/snapget.sh -m "replica_" -M -R -T 3 -b 10M "hdd/kopie" "usbrep1/replica"; m=$?; elif [ $a -eq 1 ]; then m=0; else m=$a; fi; /REPO/zfs-media-gate.sh detach usbrep1 weekA --source hdd/kopie --prefix replica_ --engine-rc $m; d=$?; [ $m -ne 0 ] && exit $m; exit $d )'
40 3 1 */3 * /REPO/zfs-job.sh "h7 replica copy (quarter)" --log=/LOG --notify=/NOTIFY --detail=8 -- /bin/sh -c '( /REPO/zfs-media-gate.sh attach usbrep3 quarter --dataset usbrep3/replica --source hdd/kopie --prefix replica_; a=$?; if [ $a -eq 0 ]; then /REPO/snapget.sh -m "replica_" -M -i "hdd/kopie" "usbrep3/replica"; m=$?; elif [ $a -eq 1 ]; then m=0; else m=$a; fi; /REPO/zfs-media-gate.sh detach usbrep3 quarter --source hdd/kopie --prefix replica_ --engine-rc $m; d=$?; [ $m -ne 0 ] && exit $m; exit $d )'

*/15 * * * * d=$(/REPO/zfs-media-gate.sh age "usbrep1" "weekA" --warn 2d --crit 4d 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /root/scripts/notify-warn.sh "h7 replica getting stale (weekA)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "h7 replica stale (weekA)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "h7 replica monitor BROKEN (weekA)" "$d" 2>>/LOG
*/15 * * * * d=$(/REPO/zfs-media-gate.sh age "usbrep3" "quarter" --warn 40d --crit 60d 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /root/scripts/notify-warn.sh "h7 replica getting stale (quarter)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "h7 replica stale (quarter)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "h7 replica monitor BROKEN (quarter)" "$d" 2>>/LOG
# END zfs-backup-managed
