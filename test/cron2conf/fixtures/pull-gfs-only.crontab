# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
# Source: /jobs.h7.conf -- DO NOT EDIT BY HAND, re-run gen-cron.sh instead
1 * * * * /R/zfs-job.sh "c1 hourly backup" --log=/L --notify=/N --detail=8 -- /R/snapget.sh -m "automated_hourly_" -K /k -A -L r1 "acct@h:rpool/vm-1" "tank/backups/h"
11 1 * * * /R/zfs-job.sh "c1 daily backup" --log=/L --notify=/N --detail=8 -- /R/snapget.sh -m "automated_daily_" -K /k -A -L r1 "acct@h:rpool/vm-1" "tank/backups/h"

21 * * * * /R/zfs-job.sh "c1 gfs prune" --log=/L --notify=/N --detail=8 -- /R/delsnaps.sh -G -L r1 "tank/backups/h/rpool/vm-1" "automated_" -H24 -D7
# END zfs-backup-managed
