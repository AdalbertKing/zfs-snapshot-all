# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
# Source: /jobs.h7.conf -- DO NOT EDIT BY HAND, re-run gen-cron.sh instead
30 2 * * * /REPO/zfs-job.sh "h7 replica copy (weekA)" --log=/LOG --notify=/NOTIFY --detail=8 -- /bin/sh -c '( /REPO/zfs-media-gate.sh attach usbrep1 weekA --dataset usbrep1/replica --source hdd/kopie --prefix replica_; a=$?; if [ $a -eq 0 ]; then /REPO/snapsend.sh -m "replica_" -R -T 3 -b 10M "hdd/kopie" "usbrep1/replica"; m=$?; elif [ $a -eq 1 ]; then m=0; else m=$a; fi; /REPO/zfs-media-gate.sh detach usbrep1 weekA --source hdd/kopie --prefix replica_ --engine-rc $m; d=$?; [ $m -ne 0 ] && exit $m; exit $d )'
40 3 1 */3 * /REPO/zfs-job.sh "h7 replica copy (quarter)" --log=/LOG --notify=/NOTIFY --detail=8 -- /bin/sh -c '( /REPO/zfs-media-gate.sh attach usbrep3 quarter --dataset usbrep3/replica --source hdd/kopie --prefix replica_; a=$?; if [ $a -eq 0 ]; then /REPO/snapsend.sh -m "replica_" -i "hdd/kopie" "usbrep3/replica"; m=$?; elif [ $a -eq 1 ]; then m=0; else m=$a; fi; /REPO/zfs-media-gate.sh detach usbrep3 quarter --source hdd/kopie --prefix replica_ --engine-rc $m; d=$?; [ $m -ne 0 ] && exit $m; exit $d )'
# END zfs-backup-managed
