# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
# Source: /jobs.h7.conf -- DO NOT EDIT BY HAND, re-run gen-cron.sh instead
30 2 * * * echo "$(date -Is) ZFS-JOB BEGIN h7 replica copy (weekA)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; ( /REPO/zfs-media-gate.sh attach usbrep1 weekA --dataset usbrep1/replica --source hdd/kopie --prefix replica_; a=$?; if [ $a -eq 0 ]; then /REPO/snapsend.sh -m "replica_" -R -T 3 -b 10M "hdd/kopie" "usbrep1/replica"; m=$?; elif [ $a -eq 1 ]; then m=0; else m=$a; fi; /REPO/zfs-media-gate.sh detach usbrep1 weekA; d=$?; [ $m -ne 0 ] && exit $m; exit $d ) 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END h7 replica copy (weekA) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h7 replica copy (weekA)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
40 3 1 */3 * echo "$(date -Is) ZFS-JOB BEGIN h7 replica copy (quarter)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; ( /REPO/zfs-media-gate.sh attach usbrep3 quarter --dataset usbrep3/replica --source hdd/kopie --prefix replica_; a=$?; if [ $a -eq 0 ]; then /REPO/snapsend.sh -m "replica_" -i "hdd/kopie" "usbrep3/replica"; m=$?; elif [ $a -eq 1 ]; then m=0; else m=$a; fi; /REPO/zfs-media-gate.sh detach usbrep3 quarter; d=$?; [ $m -ne 0 ] && exit $m; exit $d ) 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END h7 replica copy (quarter) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h7 replica copy (quarter)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
