# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
7 * * * * e=$(mktemp); /REPO/snapsend.sh -m "automated_" "tank/single,tank/explicitno" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly backup (single+explicitno)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
7 * * * * e=$(mktemp); /REPO/snapsend.sh -m "automated_" -R "tank/flatpush" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly backup (flatpush)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
7 * * * * e=$(mktemp); /REPO/snapsend.sh -m "automated_" -r "tank/atompush" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly backup (atompush)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

30 2 * * * e=$(mktemp); /REPO/delsnaps.sh "tank/single,tank/explicitno" "automated_" -H24 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly prune (single)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
30 2 * * * e=$(mktemp); /REPO/delsnaps.sh -R "tank/flatpush,tank/atompush" "automated_" -H24 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "arc hourly prune (flatpush)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

*/15 * * * * d=$(/REPO/check-snap-age.sh "tank/single,tank/explicitno" "automated_" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "arc hourly getting stale (single)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "arc hourly stale (single)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "arc hourly monitor BROKEN (single)" "$d" 2>>/LOG
*/15 * * * * d=$(/REPO/check-snap-age.sh -R "tank/flatpush,tank/atompush" "automated_" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "arc hourly getting stale (flatpush)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "arc hourly stale (flatpush)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "arc hourly monitor BROKEN (flatpush)" "$d" 2>>/LOG

0 7 * * * /DIGEST 2>>/LOG
# END zfs-backup-managed
