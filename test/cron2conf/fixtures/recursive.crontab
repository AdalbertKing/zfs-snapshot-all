7 * * * * /REPO/zfs-job.sh "arc hourly backup (single+explicitno)" --log=/LOG --notify=/NOTIFY --detail=8 -- /REPO/snapsend.sh -m "automated_" "tank/single,tank/explicitno"
7 * * * * /REPO/zfs-job.sh "arc hourly backup (flatpush)" --log=/LOG --notify=/NOTIFY --detail=8 -- /REPO/snapsend.sh -m "automated_" -R "tank/flatpush"
7 * * * * /REPO/zfs-job.sh "arc hourly backup (atompush)" --log=/LOG --notify=/NOTIFY --detail=8 -- /REPO/snapsend.sh -m "automated_" -r "tank/atompush"
30 2 * * * /REPO/zfs-job.sh "arc hourly prune (single)" --log=/LOG --notify=/NOTIFY --detail=8 -- /REPO/delsnaps.sh "tank/single,tank/explicitno" "automated_" -H24
30 2 * * * /REPO/zfs-job.sh "arc hourly prune (flatpush)" --log=/LOG --notify=/NOTIFY --detail=8 -- /REPO/delsnaps.sh -R "tank/flatpush,tank/atompush" "automated_" -H24
*/15 * * * * d=$(/REPO/check-snap-age.sh "tank/single,tank/explicitno" "automated_" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "arc hourly getting stale (single)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "arc hourly stale (single)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "arc hourly monitor BROKEN (single)" "$d" 2>>/LOG
*/15 * * * * d=$(/REPO/check-snap-age.sh -R "tank/flatpush,tank/atompush" "automated_" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "arc hourly getting stale (flatpush)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "arc hourly stale (flatpush)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "arc hourly monitor BROKEN (flatpush)" "$d" 2>>/LOG
# END zfs-backup-managed
