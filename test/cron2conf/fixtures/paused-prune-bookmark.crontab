# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
# Source: /jobs.h6.conf -- DO NOT EDIT BY HAND, re-run gen-cron.sh instead
5 * * * * echo "$(date -Is) ZFS-JOB BEGIN h6 hourly snapshot (svc1)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/snapsend.sh -m "automated_hourly_" -A -L relacja1 "tank/a" "root@10.0.0.1:hdd/kopie" 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END h6 hourly snapshot (svc1) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h6 hourly snapshot (svc1)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

35 * * * * echo "$(date -Is) ZFS-JOB BEGIN h6 hourly prune (svc1)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -L relacja1 "tank/a" "automated_hourly" -H24 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END h6 hourly prune (svc1) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h6 hourly prune (svc1)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
30 4 * * * echo "$(date -Is) ZFS-JOB BEGIN h6 bookmarks prune (bookmarks)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh -B -R -L relacja1 -p 2222 "root@10.0.0.1:hdd/kopie" "tgt-" -d30 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END h6 bookmarks prune (bookmarks) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h6 bookmarks prune (bookmarks)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
