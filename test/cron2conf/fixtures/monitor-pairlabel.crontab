# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
# Source: /jobs.h7.conf -- DO NOT EDIT BY HAND, re-run gen-cron.sh instead
1 * * * * /R/zfs-job.sh "c1 hourly backup" --log=/L --notify=/N --detail=8 -- /R/snapget.sh -m "automated_hourly_" -K /k -A -L r1 "acct@h:rpool/vm-1" "tank/backups/h"
11 1 * * * /R/zfs-job.sh "c1 daily backup" --log=/L --notify=/N --detail=8 -- /R/snapget.sh -m "automated_daily_" -K /k -A -L r1 "acct@h:rpool/vm-1" "tank/backups/h"
21 2 * * 0 /R/zfs-job.sh "c1 weekly backup" --log=/L --notify=/N --detail=8 -- /R/snapget.sh -m "automated_weekly_" -K /k -A -L r1 "acct@h:rpool/vm-1" "tank/backups/h"

21 * * * * /R/zfs-job.sh "c1 hourly prune" --log=/L --notify=/N --detail=8 -- /R/delsnaps.sh -L r1 -P "vzdump:2" "tank/backups/h/rpool/vm-1" "automated_hourly" -H24
31 1 * * * /R/zfs-job.sh "c1 daily prune" --log=/L --notify=/N --detail=8 -- /R/delsnaps.sh -L r1 -P "vzdump:2" "tank/backups/h/rpool/vm-1" "automated_daily" -D7
41 2 * * 0 /R/zfs-job.sh "c1 weekly prune" --log=/L --notify=/N --detail=8 -- /R/delsnaps.sh -L r1 -P "vzdump:2" "tank/backups/h/rpool/vm-1" "automated_weekly" -W4

*/15 * * * * d=$(/R/check-snap-age.sh -L r1 "tank/backups/h/rpool/vm-1" "automated_hourly" 90m 150m 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/L; [ $rc -eq 1 ] && /root/scripts/notify-warn.sh "c1 hourly getting stale" "$d" 2>>/L; [ $rc -eq 2 ] && /N "c1 hourly stale" "$d" 2>>/L; [ $rc -ge 3 ] && /N "c1 hourly monitor BROKEN" "$d" 2>>/L
# END zfs-backup-managed
