# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
# Source: /jobs.h3.conf -- DO NOT EDIT BY HAND, re-run gen-cron.sh instead
59 * * * * e=$(mktemp); /REPO/snapsend.sh -m "automated_" -e -v 3 "tank/src1" "tank/backups" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h3 hourly backup (svc1)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
0 4 * * * e=$(mktemp); /REPO/snapsend.sh -m "automated_daily_" -e -v 3 "tank/src2" "tank/backups" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h3 daily backup (svc2)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

30 4 * * * e=$(mktemp); /REPO/delsnaps.sh -B -R "tank" "tgt-" -d30 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h3 bookmarks prune (bookmarks)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
51 * * * * e=$(mktemp); /REPO/delsnaps.sh -G -R "tank/backups" "automated_" -H24 -D7 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h3 gfs prune (backups)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

*/15 * * * * d=$(/REPO/check-snap-age.sh "tank/backups/tank/src1" "automated_hourly" 200m 260m 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "h3 hourly getting stale (svc1)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "h3 hourly stale (svc1)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "h3 hourly monitor BROKEN (svc1)" "$d" 2>>/LOG
*/15 * * * * d=$(/REPO/check-snap-age.sh "tank/backups/tank/src2" "automated_daily" 30h 48h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "h3 daily getting stale (svc2)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "h3 daily stale (svc2)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "h3 daily monitor BROKEN (svc2)" "$d" 2>>/LOG

0 7 * * * /DIGEST 2>>/LOG
# END zfs-backup-managed
