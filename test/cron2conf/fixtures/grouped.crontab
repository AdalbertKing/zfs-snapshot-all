51 * * * * echo "$(date -Is) ZFS-JOB BEGIN h2 hourly prune (ab)" >>/LOG; e=$(mktemp 2>/dev/null) || e=/LOG.err.$$; /REPO/delsnaps.sh "tank/a,tank/b" "automated_hourly" -H24 2>"$e"; rc=$?; cat "$e" >>/LOG; echo "$(date -Is) ZFS-JOB END h2 hourly prune (ab) rc=$rc" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h2 hourly prune (ab)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
