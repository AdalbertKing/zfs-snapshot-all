*/15 * * * * d=$(/REPO/check-snap-age.sh "tank/a,tank/b" "automated_hourly" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "h2 hourly getting stale (ab)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "h2 hourly stale (ab)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "h2 hourly monitor BROKEN (ab)" "$d" 2>>/LOG
