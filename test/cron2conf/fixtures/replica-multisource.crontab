# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
# Source: /jobs.h7.conf -- DO NOT EDIT BY HAND, re-run gen-cron.sh instead
ZSA_REPO=/REPO
ZSA_LOG=/LOG
ZSA_NOTIFY=/NOTIFY
ZSA_WARN=/root/scripts/notify-warn.sh
30 2 * * * echo "$(date -Is) ZFS-JOB BEGIN h7 replica copy (weekA)" >>$ZSA_LOG; e=$(mktemp 2>/dev/null) || e=$ZSA_LOG.err.$$; ( $ZSA_REPO/zfs-media-gate.sh attach usbrep1 weekA --dataset usbrep1/replica --source hdd/kopie,rpool/data,hdd/archiwum --prefix replica_; a=$?; if [ $a -eq 0 ]; then m=0; for s in "hdd/kopie" "rpool/data" "hdd/archiwum"; do $ZSA_REPO/snapsend.sh -m "replica_" -R -T 3 -b 10M "$s" "usbrep1/replica"; r=$?; [ $m -eq 0 ] && m=$r; done; elif [ $a -eq 1 ]; then m=0; else m=$a; fi; $ZSA_REPO/zfs-media-gate.sh detach usbrep1 weekA --source hdd/kopie,rpool/data,hdd/archiwum --prefix replica_ --engine-rc $m; d=$?; [ $m -ne 0 ] && exit $m; exit $d ) 2>"$e"; rc=$?; cat "$e" >>$ZSA_LOG; echo "$(date -Is) ZFS-JOB END h7 replica copy (weekA) rc=$rc" >>$ZSA_LOG; [ $rc -ne 0 ] && $ZSA_NOTIFY "h7 replica copy (weekA)" "$(tail -n 8 "$e")" 2>>$ZSA_LOG; rm -f "$e"
# END zfs-backup-managed
