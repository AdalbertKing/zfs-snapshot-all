# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
# Source: /jobs.y.conf -- DO NOT EDIT BY HAND, re-run gen-cron.sh instead
41 0 * * * e=$(mktemp); /REPO/delsnaps.sh "tank/data" "automated_daily" -D7 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "y daily prune (data)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

43 0 * * 0 e=$(mktemp); /REPO/delsnaps.sh -R "tank/data" "automated_weekly" -W4 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "y weekly prune (data)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"
# END zfs-backup-managed
