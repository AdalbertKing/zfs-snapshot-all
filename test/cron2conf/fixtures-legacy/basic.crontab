# BEGIN zfs-backup-managed (generated by gen-cron.sh -- do not hand-edit, re-run gen-cron.sh instead)
# Source: /jobs.h1.conf -- DO NOT EDIT BY HAND, re-run gen-cron.sh instead
37 * * * * e=$(mktemp); /REPO/snapsend.sh -m "automated_hourly_" "tank/vm1" 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h1 hourly snapshot (vm1)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

51 * * * * e=$(mktemp); /REPO/delsnaps.sh "tank/vm1" "automated_hourly" -H24 2>"$e"; rc=$?; cat "$e" >>/LOG; [ $rc -ne 0 ] && /NOTIFY "h1 hourly prune (vm1)" "$(tail -n 8 "$e")" 2>>/LOG; rm -f "$e"

*/15 * * * * d=$(/REPO/check-snap-age.sh "tank/vm1" "automated_hourly" 90m 3h 2>&1); rc=$?; [ -n "$d" ] && echo "$d" >>/LOG; [ $rc -eq 1 ] && /WARN "h1 hourly getting stale (vm1)" "$d" 2>>/LOG; [ $rc -eq 2 ] && /NOTIFY "h1 hourly stale (vm1)" "$d" 2>>/LOG; [ $rc -ge 3 ] && /NOTIFY "h1 hourly monitor BROKEN (vm1)" "$d" 2>>/LOG

0 7 * * * /DIGEST 2>>/LOG
# END zfs-backup-managed
